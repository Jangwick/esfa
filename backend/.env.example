APP_NAME="Archon Nell"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
# Local: SQLite file below. Production: pgsql on the Supabase session pooler (IPv4), DB_SSLMODE=require.
DB_CONNECTION=sqlite
DB_URL=
DB_DATABASE=database/database.sqlite
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=require
CACHE_STORE=database
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
SFA_TIMEZONE=Asia/Manila
SFA_LOGIN_OTP=off
SFA_COMMIT=local
SFA_SANDBOX_GATEWAY=true
# Signs simulated gateway webhooks (POST /api/v1/webhooks/payments/sandbox); blank rejects them.
SFA_SANDBOX_WEBHOOK_SECRET=
SFA_SCHEDULER_ENABLED=true
# Process simulator for Admins (storefront/customer/gateway stand-ins). Leave unset: on locally, off in production.
SFA_SIMULATOR=
# Where the partner simulator (tools/partner-simulator) listens when you demo the integrations.
SFA_PARTNER_URL=http://localhost:8787
SFA_WEBHOOK_TIMEOUT=10
SFA_WEBHOOK_ALLOW_LOCALHOST=true
# Required in production: Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>" to /api/v1/cron/run.
CRON_SECRET=
# Production: the deployed SPA origin only, e.g. https://sfa.example.com (comma separated).
SFA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SCHEME=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TIMEOUT=15
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Archon Nell"
# Google Gemini for the AI assistant (Settings > Automation). Never commit the key; set it in Vercel for production.
SFA_GEMINI_API_KEY=
SFA_GEMINI_MODEL=gemini-3.5-flash-lite
SFA_GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
SFA_GEMINI_TIMEOUT=25
SFA_GEMINI_RETRY_PAUSE_MS=2000
# Estimate shown on Settings > Automation (USD per 1M tokens); not a bill.
SFA_GEMINI_USD_PER_M_INPUT=0.30
SFA_GEMINI_USD_PER_M_OUTPUT=2.50
